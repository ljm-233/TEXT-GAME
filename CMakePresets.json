{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },

    {
      "name": "triplet-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "triplet-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "triplet-macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },

    {
      "name": "debug",
      "inherits": ["base", "triplet-windows", "triplet-linux", "triplet-macos"],
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": ["base", "triplet-windows", "triplet-linux", "triplet-macos"],
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-legacy",
      "inherits": "release",
      "displayName": "Release (Legacy Atom)",
      "cacheVariables": {
        "LEGACY_BUILD": "ON"
      }
    },

    {
      "name": "tests",
      "inherits": "debug",
      "displayName": "Debug + Tests",
      "cacheVariables": {
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "tests",
      "displayName": "Debug + Tests + Sanitizer",
      "cacheVariables": {
        "SANITIZE": "ON"
      }
    },
    {
      "name": "release-package",
      "inherits": "release",
      "displayName": "Release (packaging)",
      "cacheVariables": {
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "release-legacy",
      "inherits": "release",
      "displayName": "Release (Legacy Atom)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LEGACY_ATOM": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "debug",
      "displayName": "Debug + clang-tidy",
      "cacheVariables": {
        "CLANG_TIDY": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "tests",
      "displayName": "Debug + Tests + Coverage",
      "cacheVariables": {
        "COVERAGE": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "debug",           "configurePreset": "debug" },
    { "name": "release",         "configurePreset": "release" },
    { "name": "tests",           "configurePreset": "tests" },
    { "name": "asan",            "configurePreset": "asan" },
    { "name": "release-package", "configurePreset": "release-package" },
    { "name": "clang-tidy",      "configurePreset": "clang-tidy" },
    { "name": "coverage",        "configurePreset": "coverage" },
    { "name": "release-legacy", "configurePreset": "release-legacy" }
  ],

  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}