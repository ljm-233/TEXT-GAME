{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "标准 Debug 构建",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "发布构建",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "tests",
      "inherits": "debug",
      "displayName": "Debug + Tests",
      "description": "Debug 构建 + 单元测试",
      "cacheVariables": {
        "BUILD_TESTS": "ON"
      }
    },

    {
      "name": "asan",
      "inherits": "tests",
      "displayName": "Debug + Tests + Sanitizer",
      "description": "开启 ASan / UBSan / LSan 的调试构建",
      "cacheVariables": {
        "SANITIZE": "ON"
      }
    },

    {
      "name": "release-package",
      "inherits": "release",
      "displayName": "Release (packaging)",
      "description": "用于 cpack 的发布构建，不含测试",
      "cacheVariables": {
        "BUILD_TESTS": "OFF"
      }
    },

    {
      "name": "clang-tidy",
      "inherits": "debug",
      "displayName": "Debug + clang-tidy",
      "description": "用 clang-tidy 做静态分析",
      "cacheVariables": {
        "CLANG_TIDY": "ON"
      }
    },

    {
      "name": "coverage",
      "inherits": "tests",
      "displayName": "Debug + Tests + Coverage",
      "description": "用 gcov / lcov 生成覆盖率报告",
      "cacheVariables": {
        "COVERAGE": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "debug",           "configurePreset": "debug" },
    { "name": "release",         "configurePreset": "release" },
    { "name": "tests",           "configurePreset": "tests" },
    { "name": "asan",            "configurePreset": "asan" },
    { "name": "release-package", "configurePreset": "release-package" },
    { "name": "clang-tidy",      "configurePreset": "clang-tidy" },
    { "name": "coverage",        "configurePreset": "coverage" }
  ],

  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}