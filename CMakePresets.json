{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug (系统 SFML)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release (系统 SFML)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "release-package",
            "inherits": "release",
            "displayName": "Release (packaging)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "tests",
            "inherits": "debug",
            "displayName": "Debug + Tests",
            "cacheVariables": {
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "asan",
            "inherits": "tests",
            "displayName": "Debug + Tests + Sanitizer",
            "cacheVariables": {
                "SANITIZE": "ON"
            }
        },
        {
            "name": "clang-tidy",
            "inherits": "debug",
            "displayName": "Debug + clang-tidy",
            "cacheVariables": {
                "CLANG_TIDY": "ON"
            }
        },
        {
            "name": "coverage",
            "inherits": "tests",
            "displayName": "Debug + Tests + Coverage",
            "cacheVariables": {
                "COVERAGE": "ON"
            }
        },
        {
            "name": "vcpkg-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            }
        },
        {
            "name": "vcpkg-debug",
            "inherits": "vcpkg-base",
            "displayName": "Debug (vcpkg)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "vcpkg-release",
            "inherits": "vcpkg-base",
            "displayName": "Release (vcpkg)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vcpkg-release-package",
            "inherits": "vcpkg-release",
            "displayName": "Release packaging (vcpkg)",
            "cacheVariables": {
                "BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "release-package",
            "configurePreset": "release-package"
        },
        {
            "name": "tests",
            "configurePreset": "tests"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "clang-tidy",
            "configurePreset": "clang-tidy"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage"
        },
        {
            "name": "vcpkg-debug",
            "configurePreset": "vcpkg-debug"
        },
        {
            "name": "vcpkg-release",
            "configurePreset": "vcpkg-release"
        },
        {
            "name": "vcpkg-release-package",
            "configurePreset": "vcpkg-release-package"
        },
        {
            "name": "Release",
            "description": "",
            "displayName": "",
            "configurePreset": "debug"
        }
    ],
    "testPresets": [
        {
            "name": "tests",
            "configurePreset": "tests",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ]
}